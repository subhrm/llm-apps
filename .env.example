# ──────────────────────────────────────────────────────────────
# tool_use_demo — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and should never be committed.
# ──────────────────────────────────────────────────────────────

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: custom OpenAI-compatible endpoint (leave blank for default OpenAI)
OPENAI_BASE_URL=

# Optional: default model to use (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: default sampling temperature 0.0–1.0 (defaults to 0.0)
OPENAI_TEMPERATURE=0.0
